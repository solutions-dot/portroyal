{
  "name": "history-games",
  "private": true,
  "description": "Educational 3D history games on one shared engine: Port Royal 1690 first, more to follow",
  "scripts": {
    "build": "node tools/build.mjs port-royal",
    "build:dev": "node tools/build.mjs port-royal --dev",
    "serve": "python3 -m http.server 8765",
    "build:all": "node tools/dist.mjs",
    "dist": "node tools/dist.mjs",
    "serve:dist": "cd dist && python3 -m http.server 8766",
    "test": "node tools/test.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "meshoptimizer": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
