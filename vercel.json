{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/port-royal",
      "destination": "/games/port-royal/site/",
      "permanent": false
    },
    {
      "source": "/kendal",
      "destination": "/games/kendal/site/",
      "permanent": false
    },
    {
      "source": "/nanny",
      "destination": "/games/nanny/site/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/games/(.*)/site/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/(.*)/site/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/games/(.*)/site/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/menu/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "review/consolidate-outstanding-branches-20261116": false,
      "review/consolidated-game-updates-20261116": false,
      "main": true,
      "fix/restore-main-deployments-20261116": false,
      "fix/menu-and-opening-scenes-20261116": false
    }
  }
}
