{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/affectionate-pasteur-xvhvlq": false
    }
  },
  "installCommand": "npm install",
  "buildCommand": "npm run dist",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/port-royal",
      "destination": "/games/port-royal/site/",
      "permanent": false
    },
    {
      "source": "/kendal",
      "destination": "/games/kendal/site/",
      "permanent": false
    },
    {
      "source": "/nanny",
      "destination": "/games/nanny/site/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/games/(.*)/site/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/games/(.*)/site/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
